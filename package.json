{
  "name": "family-planner",
  "version": "1.0.0",
  "packageManager": "pnpm@9.1.0",
  "private": true,
  "description": "Family Dashboard - Monorepo",
  "workspaces": [
    "backend",
    "frontend",
    "packages/*",
    "tests/e2e"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "pnpm --filter family-planner-backend dev",
    "dev:frontend": "pnpm --filter family-planner-frontend start",
    "dev:frontend:web": "pnpm --filter family-planner-frontend web",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:with-backend": "pnpm run docker:backend:up && sleep 5 && turbo run test:e2e; pnpm run docker:down",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "docker:up": "docker compose up --build",
    "docker:db:up": "docker compose up -d postgres",
    "docker:backend:up": "docker compose up -d postgres backend",
    "docker:down": "docker compose down",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "metro-minify-terser": "^0.83.3",
    "ts-jest": "^29.4.5",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  }
}
