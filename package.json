{
  "name": "family-planner",
  "version": "1.0.0",
  "packageManager": "npm@11.6.2",
  "private": true,
  "description": "Family Dashboard - Monorepo",
  "workspaces": [
    "backend",
    "frontend",
    "packages/*",
    "tests/e2e"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "npm run dev --workspace=family-planner-backend",
    "dev:frontend": "npm run start --workspace=family-planner-frontend",
    "dev:frontend:web": "npm run web --workspace=family-planner-frontend",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:with-backend": "npm run docker:backend:up && sleep 5 && turbo run test:e2e; npm run docker:down",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "docker:up": "docker compose up --build",
    "docker:backend:up": "docker compose up -d postgres backend",
    "docker:down": "docker compose down",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.7",
    "metro-minify-terser": "^0.83.3",
    "ts-jest": "^29.4.5",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "lint-staged": {
    "backend/**/*.ts": [
      "npm run lint:staged --workspace=family-planner-backend --"
    ],
    "frontend/**/*.{ts,tsx}": [
      "npm run lint:staged --workspace=family-planner-frontend --"
    ]
  },
  "dependencies": {
    "ajv": "^8.17.1"
  }
}
